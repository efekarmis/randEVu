# Bu dosyayı .env.local olarak kopyalayıp gerçek değerlerle doldurun.
# .env.local git'e eklenmez (bkz. .gitignore).

# --- Firebase Admin SDK (yalnızca Firestore, Spark/ücretsiz plan) ---
# Firebase Console > Proje Ayarları > Servis Hesapları > Yeni özel anahtar oluştur
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# İndirilen JSON dosyasındaki "private_key" değerini tek satırda, \n karakterlerini
# koruyarak (veya çift tırnak içinde literal newline ile) buraya yapıştırın.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Telegram Bot API ---
# @BotFather üzerinden bot oluşturup token alın.
TELEGRAM_BOT_TOKEN=
# Bildirimin gönderileceği chat id (ev sahibinin kendisiyle veya bir gruba).
TELEGRAM_CHAT_ID=
